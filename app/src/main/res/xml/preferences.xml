<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <Preference
        android:key="pref_default_settings"
        android:icon="@drawable/ic_setting_default"
        android:title="@string/profiles" />
    <Preference
        android:key="emulator_dir"
        android:icon="@drawable/ic_setting_folder"
        android:title="@string/pref_emulator_dir"
        tools:summary="/sdcard/J2ME-Loader" />
    <Preference
        android:key="pref_import_app_bg"
        android:icon="@drawable/ic_setting_image"
        android:summary="@string/apex_pref_import_hint"
        android:title="@string/apex_import_app_bg" />
    <Preference
        android:key="pref_import_window_bg"
        android:icon="@drawable/ic_setting_window"
        android:summary="@string/apex_pref_import_hint"
        android:title="@string/apex_import_window_bg" />
    <Preference
        android:key="pref_import_font"
        android:icon="@drawable/ic_setting_font"
        android:summary="@string/apex_pref_import_hint"
        android:title="@string/apex_import_font" />
</androidx.preference.PreferenceScreen>